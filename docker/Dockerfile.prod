FROM icr.io/continuous-delivery/pipeline/pipeline-base-image:2.6 as jekyll
SHELL ["/bin/bash", "-c"]

COPY gems /gems
COPY robots.txt /
COPY src /src
COPY scripts /scripts

# Upgrade the git manually to mitigate risk from CVE-2022-41903, CVE-2022-23521, CVE-2022-41953
RUN apt-get update && \
    apt-get -y install curl git python3 python3-bs4 python3-lxml \
    libgdbm-dev libncurses5-dev automake libtool bison libffi-dev && \
    add-apt-repository -y ppa:git-core/ppa && \
    apt-get update && \
    apt-get install git -y && \
    git --version

ENV BUILD_SCRIPTS_DIR=/scripts/build \
    PROD_SITE=true \
    JEKYLL_ENV=production \
    AVAILABILITY_SERVICE=OpenLiberty\ availability \
    PIPELINE_DEBUG_SCRIPT=true

RUN $BUILD_SCRIPTS_DIR/jekyll.sh

#
#
#
FROM jekyll as docs

RUN $BUILD_SCRIPTS_DIR/docs_part_1.sh && \
    $BUILD_SCRIPTS_DIR/docs_part_2.sh && \
    $BUILD_SCRIPTS_DIR/gzip.sh && \
    mkdir /temp-docs && \
    mv /target/jekyll-webapp/docs /temp-docs && \
    ls /target/jekyll-webapp

#
#
#
FROM icr.io/appcafe/open-liberty-devfile-stack:22.0.0.1 as war

# Receive JFrog Artifactory credentials as build arguments
ARG ARTIFACTORY_USER
ARG ARTIFACTORY_TOKEN

# Convert to environment variables so Maven can access them
ENV ARTIFACTORY_USER=${ARTIFACTORY_USER}
ENV ARTIFACTORY_TOKEN=${ARTIFACTORY_TOKEN}

COPY mvnw /
COPY --chown=1001:0 .mvn /.mvn
COPY pom.xml /
COPY --from=docs --chown=1001:0 /src /src
COPY --from=docs --chown=1001:0 /target /target

# Pre-download Maven distribution and wrapper JAR using curl with authentication
# This bypasses the Maven wrapper's Java HTTP client authentication issues
# Maven Wrapper will extract the zip from /tmp/ when it finds the file:// URL
# Using Maven Wrapper 3.2.0 for better Java 8+ compatibility and improved SSL/TLS support
RUN MAVEN_DIST_URL="https://na.artifactory.swg-devops.com:443/artifactory/wasliberty-maven-remote-cache/org/apache/maven/apache-maven/3.9.0/apache-maven-3.9.0-bin.zip" && \
    MAVEN_WRAPPER_JAR="https://na.artifactory.swg-devops.com/artifactory/wasliberty-maven-remote/org/apache/maven/wrapper/maven-wrapper/3.2.0/maven-wrapper-3.2.0.jar" && \
    echo "Downloading Maven distribution to /tmp/..." && \
    curl -u "${ARTIFACTORY_USER}:${ARTIFACTORY_TOKEN}" -L -o /tmp/apache-maven-3.9.0-bin.zip "${MAVEN_DIST_URL}" && \
    echo "Maven distribution downloaded successfully" && \
    curl -u "${ARTIFACTORY_USER}:${ARTIFACTORY_TOKEN}" -L -o /.mvn/wrapper/maven-wrapper.jar "${MAVEN_WRAPPER_JAR}"

# Maven does not need to know about the large amount of files generated by Antora. The antora files only need to be
# correctly placed on the file system so that the openliberty.io application can serve the files to browsers.
# When the Antora files are placed in the /target directory, this forces Maven to deal with too many files.
# Maven will encouter a JVM crash because there are too many files related to docs.

# Part 1: Remove the docs files so Maven does not need to deal with them.
# Part 2: Build the Java application
# Part 3: Restore the doc files that were previously removed
# Use Maven settings.xml to configure JFrog Artifactory mirror
# Maven will use ARTIFACTORY_USER and ARTIFACTORY_TOKEN env vars from settings.xml
RUN rm -rf /target/jekyll-webapp/docs && \
    ./mvnw -B -Dhttps.protocols=TLSv1.2 -s .mvn/settings.xml compile war:exploded && \
    mkdir target/openliberty-website-1.0-SNAPSHOT/docs

COPY --from=docs --chown=1001:0 /temp-docs/docs /target/openliberty-website-1.0-SNAPSHOT/docs

#
#
#
FROM icr.io/appcafe/open-liberty:26.0.0.7-kernel-slim-java8-ibmjava-ubi as runtime
ENV SEC_TLS_TRUSTDEFAULTCERTS true
ARG IBM_JAVA_OPTIONS=-Dhttps.protocols=TLSv1.2

COPY --chown=1001:0 src/main/wlp/server.xml /config/server.xml

# This script will add the requested XML snippets to enable Liberty features and grow image to be fit-for-purpose
# using featureUtility.
# Only available in 'kernel-slim'. The 'full' tag already includes all features for convenience.
RUN bash features.sh

COPY --from=war --chown=1001:0 target/openliberty-website-1.0-SNAPSHOT /config/apps/openliberty.war

# This script will add the requested server configurations, apply any interim fixes and populate caches to
# optimize runtime
ARG VERBOSE=true
ENV OPENJ9_SCC=false
RUN configure.sh